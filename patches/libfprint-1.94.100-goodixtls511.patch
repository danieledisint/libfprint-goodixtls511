diff --git a/meson.build b/meson.build
index ab09dc1d..95a54d38 100644
--- a/meson.build
+++ b/meson.build
@@ -141,6 +141,7 @@ drivers_info = {
     'upeksonly': {},
     'upekts': {},
     'goodixmoc': {},
+    'goodixtls511': { 'helper': ['openssl', 'opencv'] },
     'nb1010': {},
     'fpcmoc': {},
     'realtek': {},
@@ -243,6 +244,32 @@ foreach i : driver_helpers
         endif
 
         optional_deps += openssl_dep
+    elif i == 'opencv'
+        opencv_pc = dependency('opencv5', required: false)
+        opencv_features = 'opencv_features'
+        if not opencv_pc.found()
+            opencv_pc = dependency('opencv4', version: '>= 4.5', required: false)
+            opencv_features = 'opencv_features2d'
+        endif
+        if not opencv_pc.found()
+            error('OpenCV is required for @0@'.format(driver))
+        endif
+
+        # Link only the modules the driver uses. The pkg-config file lists
+        # every module (some need optional deps such as VTK), and passing it
+        # as a dependency leaks that list into the GIR scanner link, so only
+        # the include directory is taken from it.
+        opencv_libdir = opencv_pc.get_variable(pkgconfig: 'libdir')
+        opencv_incdir = opencv_pc.get_variable(pkgconfig: 'includedir_new',
+            default_value: opencv_pc.get_variable(pkgconfig: 'includedir'))
+        opencv_dep = declare_dependency(compile_args: ['-I' + opencv_incdir], dependencies: [
+            cpp.find_library('opencv_core', dirs: opencv_libdir),
+            cpp.find_library('opencv_imgproc', dirs: opencv_libdir),
+            cpp.find_library('opencv_flann', dirs: opencv_libdir),
+            cpp.find_library(opencv_features, dirs: opencv_libdir),
+        ])
+
+        optional_deps += opencv_dep
     elif i == 'udev'
         install_udev_rules = true
 
